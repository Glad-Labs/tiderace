.cache/
__pycache__/
*.pyc

# Your catch log is yours. It is the only irreplaceable thing here and it
# should never be pushed anywhere by accident.
data/catch_log.jsonl
# Bait sightings carry coordinates. Where you saw bait is where you were
# fishing, so this is spot information by another name.
data/bait_log.jsonl

# Chart features are regenerated from NOAA with `python3 -m tiderace charts`.
# Committing them bloats history on every refresh and goes stale silently.
data/charts/

# Trip tracks. The most sensitive file in the project by a distance: a track is
# not "a spot you saved", it is every spot you actually fished, in order, with
# how long you sat on each one. Never committed, never transmitted anywhere but
# your own machine over the tailnet.
data/tracks.jsonl

# Your own marks. Never committed, never transmitted, never exported.
data/my_spots.json

# NOAA station catalog. Regenerate with `tiderace stations --refresh`.
data/stations.json

# GSO spreadsheets and the climatology derived from them. Regenerate with
# `python3 -m tiderace gso --rebuild`. Their data use policy asks for citation,
# so redistributing copies here would be the wrong default.
data/gso/

# Local settings, including whose licence you fish under.
data/config.json

# Extraction review queue — claims awaiting human approval, not facts.
data/review_queue.jsonl

# Editable-install metadata
*.egg-info/
build/
dist/

# Fetched-response cache (iNaturalist, CO-OPS, NDBC, satellite). Entirely
# regenerable, 16 MB and growing, and it was swept into a commit by a careless
# `git add -A` -- which is exactly the kind of thing an ignore rule is for.
data/cache/

# Basemap tiles. A Rhode Island pmtiles extract is 100-200 MB of someone
# else's data; it belongs on the machine, not in the history.
data/pmtiles/
*.pmtiles

# When each source was last scraped and whether it worked. Machine state, not
# project state: it says whether THIS install's data is current.
data/scrape_runs.json
